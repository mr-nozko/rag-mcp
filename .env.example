# RAGMcp Environment Variables
# Copy this file to .env and fill in your values
# The .env file is gitignored and will NOT be committed to version control

# --- Required ---

# OpenAI API Key for embedding generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# --- Required for HTTP transport (serve-http command) ---

# API key used to authenticate HTTP requests to the MCP server
# Generate a strong random key: openssl rand -base64 32
RAGMCP_API_KEY=your-ragmcp-api-key-here

# --- Optional ---

# Override the config file location (default: ./config.toml)
# RAGMCP_CONFIG=./config.toml

# Override the log level (default: info)
# RUST_LOG=info

# Password gate for GET/POST /authorize when serving publicly (Railway/Render).
# Leave unset for local/dev auto-approve OAuth redirect.
# RAGMCP_AUTH_PASSWORD=your-strong-password

# --- Cloudflare R2 (optional portable server / pull-r2) ---

# Required when [storage] backend = "r2" or when using `ragmcp pull-r2`
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Bucket + endpoint: prefer these over [storage.r2] in TOML so public repos keep placeholders.
# On Render, set these as Environment Variables (do not commit real values).
# R2_BUCKET=your-real-bucket-name
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Optional: override snapshot object key (default from TOML / _ragmcp/ragmcp.db)
# R2_SNAPSHOT_KEY=_ragmcp/ragmcp.db

# --- PageIndex Reasoning (Optional) ---

# To use Ollama/Local LLM for Reasoning (Zero token cost):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama  # Any non-empty string for local models
